# =============================================================================
# TRAVELMATE ENVIRONMENT CONFIGURATION (.env.example)
# All values must remain empty in this template.
# =============================================================================

# --- Database & Persistent Storage ---
# PostgreSQL connection URI (e.g. Supabase connection pooler)
DATABASE_URL=
# Supabase project URL
SUPABASE_URL=
# Supabase public anonymous API key
SUPABASE_ANON_KEY=
# Supabase service role secret key (backend admin operations)
SUPABASE_SERVICE_ROLE_KEY=

# --- Chatbot & Itinerary AI (Gemini / Anthropic) ---
# Gemini API Key used by tmChatbotController and smart itinerary generator
GEMINI_API_KEY=
# Secondary Python/FastAPI microservice endpoint (optional fallback)
AI_SERVICE_URL=
# Frontend client-side AI microservice URL (optional)
VITE_AI_URL=

# --- Translation & Speech (Digital India Bhashini) ---
# Bhashini ULCA API Key for speech and text translation
BHASHINI_API_KEY=
# Bhashini User ID for MeitY National Language Translation Mission
BHASHINI_USER_ID=
# Bhashini Pipeline ID for ULCA pipeline routing
BHASHINI_PIPELINE_ID=
# Bhashini Inference Endpoint URL
BHASHINI_PIPELINE_ENDPOINT=
# Bhashini Inference API key (optional pipeline inference key)
BHASHINI_INFERENCE_API_KEY=
# Frontend fallback: Bhashini API Key
VITE_BHASHINI_API_KEY=
# Frontend fallback: Bhashini User ID
VITE_BHASHINI_USER_ID=
# Frontend fallback: Bhashini Pipeline Endpoint
VITE_BHASHINI_PIPELINE_ENDPOINT=
# Frontend fallback: Bhashini Inference API Key
VITE_BHASHINI_INFERENCE_API_KEY=

# --- Maps & Route Navigation (Google Maps Platform) ---
# Backend Google Maps API Key for server-side places and geocoding proxy
GOOGLE_MAPS_API_KEY=
# Frontend Google Maps API Key for interactive client-side vector maps and street view
VITE_GOOGLE_MAPS_API_KEY=

# --- News & Safety Disruption Intelligence ---
# Real-time news aggregator API key (NewsAPI.org or GNews) for destination safety updates
VITE_NEWS_API_KEY=
# News aggregator API base endpoint
VITE_NEWS_API_URL=

# --- Server & Networking ---
# Server execution environment (development | production)
NODE_ENV=
# Server execution port (defaults to 3000 in container)
PORT=
# Server host binding
HOST=
# Environment identifier
ENV=
# Allowed origins for Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN=
# Frontend backend API base URL
VITE_API_URL=
