# ==============================================================================
# TravelMate AI Microservice Environment Variables (Render Web Service)
# ==============================================================================

# Server Environment (Render automatically injects PORT, e.g. 10000; defaults to 8000 locally)
PORT=8000
HOST=0.0.0.0
ENV=production

# Anthropic Claude API Key (Required for Claude 3.5 Sonnet RAG & Incident Structuring)
# Obtain from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Allowed CORS Origins
# Comma-separated list of allowed frontend origins, or * for open access.
# Note: Vercel domains (*.vercel.app) and localhost are automatically accepted.
CORS_ORIGIN=https://travelmate-frontend.vercel.app
